
LET A(x) = e() AND PREVIOUS ((NOT e()) SINCE A(x)) IN
LET B(x) = e() AND PREVIOUS ((NOT e()) SINCE B(x)) IN
LET C(x) = e() AND PREVIOUS ((NOT e()) SINCE C(x)) IN
LET D() = e() AND PREVIOUS ((NOT e()) SINCE D()) IN
LET dom(x) = (NOT e()) AND ONCE A(x) OR ONCE B(x) OR ONCE C(x) IN

(((A(x) AND B(x)) OR dom(x)) SINCE C(x)) AND e()

